# ==============================================================================
# DoorbellCam configuration — copy to .env and fill in your own values
#   cp .env.example .env
# Never commit your real .env — it is already listed in .gitignore.
# ==============================================================================

# ---------------- WiFi used by the ESP32-CAM (2.4 GHz only!) ------------------
# The ESP32-CAM cannot see 5 GHz networks. If your router combines bands
# under one SSID, connect the module once from a phone to confirm it can see
# the SSID, or create/rename a dedicated 2.4 GHz SSID on your router.
WIFI_SSID=YourWifiNetwork
WIFI_PASSWORD=YourWifiPassword

# ---------------- Board / flashing ----------------
# cam_board:  ai_thinker | wrover_kit | esp_wrover_kit | esp32cam_probe
CAM_BOARD=ai_thinker
# Serial port of the ESP32-CAM-MB programmer (CH340). On Linux: /dev/ttyUSB0
# Leave AUTO to detect the USB programmer automatically (recommended -
# prevents flashing the wrong board). Only pin a port if you have several
# serial devices and auto-detection picks the wrong one.
SERIAL_PORT=AUTO
FLASH_SPEED=115200

# ---------------- Hub (the "brain") ----------------
HUB_PORT=8765
# Fallback used when mDNS and subnet scanning both fail (should not happen).
CAM_IP=
# Subnet to scan for the camera, e.g. 192.168.1.0/24. Auto-detected if empty.
LOCAL_SUBNET=

# ---------------- Detection tuning ----------------
MOTION_SENSITIVITY=25
COOLDOWN_SECONDS=15
FACE_MATCH_THRESHOLD=0.42

# ---------------- Face recognition model ----------------
MODELS_DIR=./tools/models

# ---------------- FCM (optional; off unless configured) ----------------
# Create a Firebase project, put the service-account JSON next to this file and
# uncomment: FCM_SERVICE_ACCOUNT=./firebase-service-account.json

# ---------------- Timezone for event timestamps ----------------
TZ_OFFSET_HOURS=0
